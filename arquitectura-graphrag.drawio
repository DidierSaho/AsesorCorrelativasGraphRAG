<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="arquitectura-actual" name="Arquitectura actual">
    <mxGraphModel dx="1800" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Asesor académico GraphRAG · Arquitectura actual" style="text;html=1;align=left;fontSize=28;fontStyle=1;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1650" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Consultas atómicas + recuperación documental en AWS + relaciones locales del plan. Componentes y flechas editables." style="text;html=1;align=left;fontSize=15;fontColor=#607078;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1700" height="35" as="geometry"/></mxCell>
        <mxCell id="local" value="COMPUTADORA LOCAL · Python / Streamlit · localhost:8501" style="swimlane;html=1;startSize=45;rounded=1;fillColor=#F4F5F6;swimlaneFillColor=#FAFAFB;strokeColor=#AAB4BD;fontColor=#344452;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="560" height="900" as="geometry"/></mxCell>
        <mxCell id="aws" value="AWS · Cuenta y región configuradas por el usuario" style="swimlane;html=1;startSize=45;rounded=1;fillColor=#ECE8F3;swimlaneFillColor=#FCFBFD;strokeColor=#B5A7C5;fontColor=#514263;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="1120" height="900" as="geometry"/></mxCell>
        <mxCell id="user" value="Usuario / navegador&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pregunta libre · mapa · respuesta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE7DA;strokeColor=#BBA888;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="225" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="state" value="Historial visual del chat&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;st.session_state&lt;br&gt;Cada consulta es independiente&lt;br&gt;Sin persistencia en una BD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#AAB4BD;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="225" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="app" value="Chat y orquestación&lt;br&gt;&lt;b&gt;app.py · Streamlit + Boto3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Recibe mensajes, llama APIs&lt;br&gt;y coordina la presentación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEE6EC;strokeColor=#8D9EAC;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="plan" value="Plan de correlativas LOCAL&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;PREREQUISITES&lt;br&gt;COURSE_LEVELS&lt;br&gt;COURSE_DESCRIPTIONS&lt;br&gt;9 materias · 9 relaciones&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EEE7DA;strokeColor=#BBA888;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="560" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="rules" value="Selección determinista de relaciones&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;academic_context()&lt;br&gt;Calcula anteriores, posteriores,&lt;br&gt;roadmaps y alcance del mapa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE9E2;strokeColor=#8DA793;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="render" value="Presentación y conclusión&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;HTML / SVG + CSS + JavaScript&lt;br&gt;Mapa local con hover / clic&lt;br&gt;immediate_summary(): resumen local&lt;br&gt;Respuesta original de Bedrock&lt;br&gt;y fuentes en un desplegable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEE6EC;strokeColor=#8D9EAC;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="780" width="240" height="160" as="geometry"/></mxCell>
        <mxCell id="localnote" value="IMPORTANTE&lt;br&gt;El mapa y el resumen no se descargan de Neptune.&lt;br&gt;Se calculan con el plan local.&lt;br&gt;Las consultas ambiguas piden aclaración antes de consultar la KB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#C9B387;fontSize=13;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="350" y="780" width="210" height="160" as="geometry"/></mxCell>
        <mxCell id="interpret" value="Amazon Bedrock Runtime&lt;br&gt;&lt;b&gt;Modelo de texto · interpretación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Converse&lt;br&gt;Pregunta actual + catálogo → JSON&lt;br&gt;intent / subjects / focus&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7DFF0;strokeColor=#AA95BF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="generation" value="Amazon Bedrock Runtime&lt;br&gt;&lt;b&gt;Modelo de texto · generación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Contexto recuperado + pregunta&lt;br&gt;→ respuesta en español&lt;br&gt;Modelo o perfil configurado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7DFF0;strokeColor=#AA95BF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="profilenote" value="Son dos usos del modelo configurado,&lt;br&gt;no modelos entrenados por la app.&lt;br&gt;&lt;br&gt;Si se utiliza inferencia entre regiones,&lt;br&gt;el enrutamiento depende del perfil elegido." style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;fontColor=#685776;" vertex="1" parent="1"><mxGeometry x="1420" y="235" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="kb" value="Amazon Bedrock Knowledge Bases&lt;br&gt;&lt;b&gt;Base de conocimiento GraphRAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;API: RetrieveAndGenerate&lt;br&gt;Recupera contexto, coordina generación&lt;br&gt;y devuelve respuesta + citas&lt;br&gt;Sin reutilizar sesiones entre consultas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DED2EB;strokeColor=#9E83B6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1040" y="470" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="neptune" value="Amazon Neptune Analytics&lt;br&gt;&lt;b&gt;Grafo + vectores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Entidades y relaciones extraídas&lt;br&gt;Embeddings de documentos&lt;br&gt;Búsqueda semántica + recorrido&lt;br&gt;de conexiones del grafo&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#DFE7ED;strokeColor=#8EA2B2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1420" y="470" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="retrievalnote" value="GraphRAG recupera evidencia documental.&lt;br&gt;No equivale a ejecutar una regla exacta&lt;br&gt;de habilitación académica.&lt;br&gt;La app no consulta Neptune directamente.&lt;br&gt;No inspeccionamos aquí su esquema extraído." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F1F8;strokeColor=#C6B8D1;fontSize=13;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="ingestionlabel" value="PREPARACIÓN DEL CONOCIMIENTO · al cargar documentos y sincronizar; no en cada mensaje" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#677F6D;" vertex="1" parent="1"><mxGeometry x="700" y="710" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="s3" value="Amazon S3&lt;br&gt;&lt;b&gt;Documentos Markdown&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Bucket privado de documentos&lt;br&gt;Plan, contenidos y correlativas&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E0EBDD;strokeColor=#92AC88;fontSize=15;" vertex="1" parent="1"><mxGeometry x="700" y="820" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="titan" value="Bedrock · Modelo de embeddings&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Texto → vectores numéricos&lt;br&gt;Dimensiones según configuración&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7DFF0;strokeColor=#AA95BF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="820" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="extract" value="Bedrock · Modelo de construcción&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Construcción del grafo&lt;br&gt;Extrae entidades y relaciones&lt;br&gt;durante la ingestión&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7DFF0;strokeColor=#AA95BF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1420" y="820" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="syncnote" value="Knowledge Base coordina parser / chunking, modelos e indexación. Sync: StartIngestionJob. No se entrena un modelo nuevo." style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;fontColor=#677F6D;" vertex="1" parent="1"><mxGeometry x="700" y="990" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="iam" value="SEGURIDAD · IAM y credenciales&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Perfil AWS local / credenciales temporales → Boto3 firma las llamadas (no hay claves AWS en el navegador).&lt;br&gt;Converse requiere bedrock:InvokeModel; consulta: bedrock:RetrieveAndGenerate.&lt;br&gt;Rol de servicio de la KB → lectura S3, invocación de modelos y acceso a Neptune Analytics.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2ECE1;strokeColor=#BDAE91;fontSize=16;align=left;spacing=15;" vertex="1" parent="1"><mxGeometry x="640" y="1100" width="1120" height="125" as="geometry"/></mxCell>
        <mxCell id="legend" value="LEYENDA&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Línea continua: consulta y lógica local&lt;br&gt;Línea punteada verde: ingestión / Sync&lt;br&gt;Dos copias del plan: S3 y Python&lt;br&gt;deben mantenerse consistentes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFB;strokeColor=#AAB4BD;fontSize=16;align=left;spacing=15;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="560" height="125" as="geometry"/></mxCell>
        <mxCell id="footer" value="Implementación actual: app local; sin Lambda, API Gateway, EC2 ni AgentCore. No se acumulan aprobaciones ni se evalúa habilitación para cursar. El mapa completo local no requiere consulta a AWS." style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;fontColor=#607078;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1720" height="55" as="geometry"/></mxCell>
        <mxCell id="e1" value="1 · mensaje / resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C7F8C;endArrow=block;startArrow=block;fontSize=12;" edge="1" parent="1" source="user" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="sin contexto acumulado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C7F8C;endArrow=block;startArrow=block;fontSize=12;" edge="1" parent="1" source="state" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="2 · Converse / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9174A8;endArrow=block;startArrow=block;fontSize=12;exitX=1;exitY=0.2;entryX=0;entryY=0.65;" edge="1" parent="1" source="app" target="interpret"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="414"/><mxPoint x="620" y="315"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="3 · intención interpretada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C7F8C;endArrow=block;fontSize=12;" edge="1" parent="1" source="app" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="relaciones exactas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9D8968;endArrow=block;fontSize=12;" edge="1" parent="1" source="plan" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="4 · RetrieveAndGenerate / respuesta + citas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9174A8;endArrow=block;startArrow=block;fontSize=12;exitX=1;exitY=0.65;entryX=0;entryY=0.12;" edge="1" parent="1" source="app" target="kb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="468"/><mxPoint x="620" y="440"/><mxPoint x="1000" y="440"/><mxPoint x="1000" y="490"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="5 · recuperar contexto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9174A8;endArrow=block;startArrow=block;fontSize=12;" edge="1" parent="1" source="kb" target="neptune"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="6 · consulta atómica / respuesta generada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9174A8;endArrow=block;startArrow=block;fontSize=12;" edge="1" parent="1" source="kb" target="generation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="7 · nodos y relaciones directas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C7F8C;endArrow=block;fontSize=12;" edge="1" parent="1" source="rules" target="render"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="respuesta y fuentes de AWS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C7F8C;endArrow=block;fontSize=12;exitX=0;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="app" target="render"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="474"/><mxPoint x="60" y="860"/></Array></mxGeometry></mxCell>
        <mxCell id="i1" value="A · lectura S3 / Sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78967E;dashed=1;endArrow=block;fontSize=12;exitX=1;exitY=0.2;entryX=0;entryY=0.85;" edge="1" parent="1" source="s3" target="kb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="848"/><mxPoint x="990" y="615"/></Array></mxGeometry></mxCell>
        <mxCell id="i2" value="B · fragments / embeddings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78967E;dashed=1;endArrow=block;startArrow=block;fontSize=12;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="kb" target="titan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i3" value="C · extracción de relaciones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78967E;dashed=1;endArrow=block;startArrow=block;fontSize=12;exitX=0.85;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="kb" target="extract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="770"/><mxPoint x="1380" y="770"/><mxPoint x="1380" y="880"/></Array></mxGeometry></mxCell>
        <mxCell id="i4" value="D · indexar grafo + vectores" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#78967E;dashed=1;endArrow=block;fontSize=12;exitX=0.65;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="kb" target="neptune"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="690"/><mxPoint x="1560" y="690"/></Array></mxGeometry></mxCell>
